;; stations.nls
;;
;; Creates the stations and handles bike pick-ups and returns.
;; Design rule: n-bikes is only changed by the procedures in this file.

;; ---------------------------------------------------------------------------
;; Setup
;; ---------------------------------------------------------------------------

;; Read data/params.csv and data/stations.csv (built by Python/build_inputs.py)
;; and create one station agent per row.
to setup-stations
  load-params

  set station-by-id table:make
  let rows csv:from-file "data/stations.csv"
  let header first rows
  foreach but-first rows [ row ->
    create-stations 1 [
      table:put station-by-id (column row header "station_id") self
      set station-id    column row header "station_id"
      set station-name  column row header "name"
      setxy (column row header "xcor") (column row header "ycor")
      set capacity      column row header "capacity"
      set max-bikes     column row header "max_bikes"
      set n-bikes       column row header "initial_bikes"
      set zone          column row header "zone"
      set minutes-empty 0
      set minutes-full  0
      set shape "circle"
      set size 1 + capacity / 15   ; 17 docks -> 2.1 patches, 42 docks -> 3.8
    ]
  ]
  update-station-colors
end

;; params.csv has one "name,value" pair per row.
to load-params
  let params table:from-list but-first csv:from-file "data/params.csv"
  set meters-per-patch table:get params "meters_per_patch"
  set ride-speed-mps   table:get params "ride_speed_mps"
  set detour-factor    table:get params "detour_factor"
end

;; Value of a CSV column by its header name, so the code does not depend
;; on the column order.
to-report column [ row header col-name ]
  report item (position col-name header) row
end

;; ---------------------------------------------------------------------------
;; Bikes in and out (the only code that changes n-bikes)
;; ---------------------------------------------------------------------------

;; A user takes one bike from stn. Reports true if there was one.
to-report take-bike [ stn ]
  if [n-bikes] of stn = 0 [ report false ]
  ask stn [ set n-bikes n-bikes - 1 ]
  report true
end

;; A user leaves one bike at stn: in a free dock or, when all docks are
;; taken, as overflow, up to max-bikes. Reports true if there was room.
to-report return-bike [ stn ]
  if [n-bikes] of stn >= [max-bikes] of stn [ report false ]
  ask stn [ set n-bikes n-bikes + 1 ]
  report true
end

;; A truck loads up to n bikes from stn. Reports how many it actually took.
to-report load-bikes [ stn n ]
  let moved min (list n [n-bikes] of stn)
  ask stn [ set n-bikes n-bikes - moved ]
  report moved
end

;; A truck unloads up to n bikes at stn, into free docks only (an operator
;; does not create overflow on purpose). Reports how many it left.
to-report unload-bikes [ stn n ]
  let moved max (list 0 (min (list n ([capacity] of stn - [n-bikes] of stn))))
  ask stn [ set n-bikes n-bikes + moved ]
  report moved
end

;; ---------------------------------------------------------------------------
;; Distances and nearest stations
;; ---------------------------------------------------------------------------

;; Distance in meters along the streets: straight line x detour factor.
to-report distance-m [ a b ]
  report [distance b] of a * meters-per-patch * detour-factor
end

;; Nearest other station with a bike to rent, at most max-m meters away
;; from stn, or nobody.
to-report nearest-station-with-bike [ stn max-m ]
  let candidates stations with [
    self != stn and n-bikes > 0 and distance-m stn self <= max-m
  ]
  report min-one-of candidates [ distance-m stn self ]
end

;; Nearest other station with room to leave a bike, or nobody.
to-report nearest-station-with-dock [ stn ]
  let candidates stations with [ self != stn and n-bikes < max-bikes ]
  report min-one-of candidates [ distance-m stn self ]
end

;; ---------------------------------------------------------------------------
;; Display
;; ---------------------------------------------------------------------------

;; red    = empty, no bike to rent
;; green  = bikes and free docks
;; yellow = all docks taken, bikes left as overflow
;; blue   = full up to max-bikes, returns are redirected
to update-station-colors
  ask stations [
    set color (ifelse-value
      n-bikes = 0          [ red ]
      n-bikes >= max-bikes [ blue ]
      n-bikes >= capacity  [ yellow ]
                           [ green ])
  ]
end
