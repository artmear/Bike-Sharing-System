;; demand.nls
;;
;; Generates user trip requests (when they happen, where they start and
;; where they end) and moves the users while they ride.

;; ---------------------------------------------------------------------------
;; Setup: load the input tables built by Python/build_inputs.py
;; ---------------------------------------------------------------------------

to setup-demand
  load-demand-rates
  load-bands
  load-destinations
  load-speeds
end

;; speed-bands: list of [band-max-m speeds], shortest distance band first.
;; Each band holds 100 percentiles of the real ride speeds for trips of
;; that length; a ride draws one of them.
to load-speeds
  let rows csv:from-file "data/speeds.csv"
  let header first rows
  let by-band table:make
  foreach but-first rows [ row ->
    let key column row header "band_max_m"
    table:put by-band key lput (column row header "speed_mps") (table:get-or-default by-band key [])
  ]
  set speed-bands sort-by [ [a b] -> first a < first b ] table:to-list by-band
end

;; demand-rates: (list station-id hour) -> requests per hour
to load-demand-rates
  set demand-rates table:make
  let rows csv:from-file "data/demand_rates.csv"
  let header first rows
  foreach but-first rows [ row ->
    let key (list (column row header "station_id") (column row header "hour"))
    table:put demand-rates key (column row header "rate_per_hour")
  ]
end

;; band-of-hour: list of 24 band names, e.g. item 8 = "morning"
to load-bands
  let rows csv:from-file "data/bands.csv"
  let header first rows
  let by-hour sort-by [ [a b] -> column a header "hour" < column b header "hour" ] but-first rows
  set band-of-hour map [ row -> column row header "band" ] by-hour
end

;; destination-probs: (list origin-id band) -> list of [dest-id prob],
;; most likely destination first (the CSV is already sorted that way).
to load-destinations
  set destination-probs table:make
  let rows csv:from-file "data/destinations.csv"
  let header first rows
  foreach but-first rows [ row ->
    let key (list (column row header "origin_id") (column row header "band"))
    let entry (list (column row header "dest_id") (column row header "prob"))
    table:put destination-probs key lput entry (table:get-or-default destination-probs key [])
  ]
end

;; ---------------------------------------------------------------------------
;; Lookups
;; ---------------------------------------------------------------------------

;; Requests per hour at station stn at the current hour.
to-report current-rate [ stn ]
  report table:get demand-rates (list [station-id] of stn hour-of-day)
end

;; Time band of the current hour ("morning", "midday", "evening", "night").
to-report current-band
  report item hour-of-day band-of-hour
end

;; ---------------------------------------------------------------------------
;; Each tick
;; ---------------------------------------------------------------------------

;; Each minute, each station receives a random number of rental requests.
;; The number follows a Poisson distribution with mean
;; (requests per hour / 60) x demand-multiplier.
to generate-demand
  ask stations [
    let mean-requests current-rate self / 60 * demand-multiplier
    repeat random-poisson mean-requests [ handle-request self ]
  ]
end

;; A user wants a bike at station stn.
;; 1. If stn has a bike, take it.
;; 2. Otherwise walk to the nearest station with a bike within max-walk-m.
;; 3. If there is none, give up (unmet demand: no bike).
to handle-request [ stn ]
  set n-requests n-requests + 1
  if take-bike stn [
    start-ride stn
    stop
  ]
  let alt nearest-station-with-bike stn max-walk-m
  ifelse alt != nobody and take-bike alt [
    set total-walk-m total-walk-m + distance-m stn alt
    start-ride alt
  ] [
    set n-no-bike n-no-bike + 1
  ]
end

;; A user starts riding from station stn (the bike is already taken).
;; The destination is drawn from the probabilities of the current band.
to start-ride [ stn ]
  let dest pick-destination stn
  ask stn [
    hatch-users 1 [
      set origin stn
      set destination dest
      set intended dest
      set arrival-minute ticks + ride-minutes stn dest
      set color white
      set size 2
      set shape ifelse-value member? "bike" shapes [ "bike" ] [ "default" ]
      face dest
    ]
  ]
end

;; Random destination for a trip starting at stn now, weighted by prob.
to-report pick-destination [ stn ]
  let options table:get destination-probs (list [station-id] of stn current-band)
  let choice rnd:weighted-one-of-list options [ entry -> last entry ]
  report table:get station-by-id first choice
end

;; Ride time in whole minutes (at least 1) between two places, with a
;; speed drawn from the real speeds of rides of similar length.
to-report ride-minutes [ from-agent to-agent ]
  let meters distance-m from-agent to-agent
  let seconds meters / random-ride-speed meters
  report max (list 1 round (seconds / 60))
end

;; One random speed (m/s) from the distance band that contains meters.
to-report random-ride-speed [ meters ]
  let band first filter [ b -> first b >= meters ] speed-bands
  report one-of last band
end

;; Each minute, riding users move towards their destination so that they
;; reach it exactly at arrival-minute; then they try to return the bike.
to move-users
  ask users [
    ifelse ticks >= arrival-minute [
      arrive
    ] [
      face destination
      fd distance destination / (arrival-minute - ticks)
    ]
  ]
end

;; The user is at the destination and tries to leave the bike.
;; If the station is full (n-bikes = max-bikes), ride on to the nearest
;; station with room; the walk from there back to the intended station
;; counts as extra walking.
to arrive
  if return-bike destination [
    if destination != intended [
      set total-walk-m total-walk-m + distance-m destination intended
    ]
    die
  ]
  set n-no-dock n-no-dock + 1
  let alt nearest-station-with-dock destination
  if alt = nobody [            ; every station full: try again next minute
    set arrival-minute ticks + 1
    stop
  ]
  set arrival-minute ticks + ride-minutes destination alt
  set destination alt
  face alt
end
